export struct RichTextRun {
    text: string,
    bold: bool,
    italic: bool,
    underline: bool,
    horizontal_align: int, // 0 left, 1 center, 2 right
    font_size_px: int,
    font_family: string,
    color_mode: int, // 0 default, 1 palette, 2 rgba
    palette_color: int,
    color_rgba: color,
    link_kind: int, // 0 none, 1 artist, 2 album, 3 genre, 4 decade, 5 title
    link_value: string,
    link_album: string,
    link_album_artist: string,
    link_track_path: string,
}

export struct RichTextLine {
    runs: [RichTextRun],
}

export struct RichTextBlock {
    plain_text: string,
    lines: [RichTextLine],
    vertical_align: int, // 0 top, 1 center, 2 bottom
}

export struct TrackRowData {
    status: string,
    values: [string],
    rich_values: [RichTextBlock],
    album_art: image,
    has_album_art: bool,
    source_badge: string,
    favorited: bool,
    selected: bool,
    unavailable: bool,
}

export struct LibraryRowData {
    leading: string,
    primary: string,
    secondary: string,
    primary_rich: RichTextBlock,
    secondary_rich: RichTextBlock,
    item_kind: int, // 0 track, 1 artist, 2 album, 3 genre, 4 decade
    album_art: image,
    has_album_art: bool,
    source_badge: string,
    is_playing: bool,
    playback_active: bool,
    favoritable: bool,
    favorited: bool,
    selected: bool,
}

export struct MetadataEditorField {
    id: string,
    field_name: string,
    value: string,
    common: bool,
    /// true when the value is an aggregated multi-track placeholder (mixed values across tracks)
    mixed: bool,
}

export struct PropertiesMediaInfoField {
    id: string,
    label: string,
    value: string,
}

export struct PropertiesEmbeddedImageSlot {
    picture_type_code: int,
    label: string,
    details: string,
    preview: image,
    has_preview: bool,
    has_image: bool,
    common: bool,
    /// true when more than one selected track has an image in this slot (multi-select only)
    has_multiple_images: bool,
}

export struct PropertiesExternalImage {
    file_name: string,
    label: string,
    details: string,
    path: string,
    preview: image,
    has_preview: bool,
}

export struct LayoutSplitterModel {
    id: string,
    axis: int,
    x_px: int,
    y_px: int,
    width_px: int,
    height_px: int,
    ratio: float,
    min_ratio: float,
    max_ratio: float,
    track_start_px: int,
    track_length_px: int,
}

export struct LayoutButtonClusterPanelModel {
    leaf_id: string,
    x_px: int,
    y_px: int,
    width_px: int,
    height_px: int,
    visible: bool,
    actions: [int],
}

export struct LayoutMetadataViewerPanelModel {
    leaf_id: string,
    x_px: int,
    y_px: int,
    width_px: int,
    height_px: int,
    visible: bool,
    display_priority: int,
    metadata_source: int,
    metadata_text_format: string,
    display_text: RichTextBlock,
    display_text_full: string,
    display_text_elided: bool,
}

export struct BatchFilePreviewItem {
    source_name: string,
    dest_folder: string,
    dest_filename: string,
    is_valid: bool,
    is_skipped: bool,
    is_duplicate: bool,
}

export struct BatchFileResultItem {
    source_name: string,
    dest_path: string,
    success: bool,
    error: string,
}

// Conversion settings structs — all fields are option indices into the UI combo boxes.
export struct BatchConversionWavSettings {
    bit_depth_index: int,   // 0=16-bit, 1=24-bit, 2=float32
}

export struct BatchConversionFlacSettings {
    compression_index: int, // 0..=8 compression level
    bit_depth_index: int,   // 0=16-bit, 1=24-bit
}

export struct BatchConversionOpusSettings {
    bitrate_index: int,     // 0=64k, 1=96k, 2=128k, 3=192k, 4=256k
}

export struct BatchConversionMp3Settings {
    mode_index: int,        // 0=CBR, 1=VBR
    cbr_bitrate_index: int, // 0=128k, 1=192k, 2=256k, 3=320k
    vbr_quality_index: int, // 0=V0, 1=V2, 2=V4
}

export struct LayoutAlbumArtViewerPanelModel {
    leaf_id: string,
    x_px: int,
    y_px: int,
    width_px: int,
    height_px: int,
    visible: bool,
    display_priority: int,
    image_source: int,
    art_source: image,
    has_art: bool,
}
